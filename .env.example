# =============================================================================
# yog-sothoth — configuration du workspace
# =============================================================================
# Copy this file to .env at the workspace root and fill in the values.
# .env is git-ignored — never commit real credentials.
#
# ⚠️ ONE file, TWO readers, and that is why a variable can look unused :
#   - every binary loads it itself, through `dotenvy::dotenv()` — so a value
#     unset in your shell is still read from here. To run genuinely without a
#     variable you need a different working directory, not an `unset`;
#   - `docker compose` reads it too, to interpolate docker-compose.yml.
# Each process then reads only the variables it cares about.
#
# LAYOUT — one section per crate, in the order the pipeline runs :
#
#   header       transverse (every binary), build tooling, and the two
#                conventions that span crates : endpoints, and Postgres roles
#   yog-migrate  schema owner, one-shot
#   yog-indexer  ingestion — and the ONE place where two variables must be
#                switched together, laid out as two blocks to swap
#   yog-context  token metadata, prices, pool accounts
#   yog-signals  detectors (everything optional)
#   yog-api      HTTP surface
#   yog-archive  the backup daemon: pg_dump every 6 h to an S3 bucket
#   compose      the Postgres container itself — not a crate
#   web          lives in web/.env, not here
# =============================================================================


# -----------------------------------------------------------------------------
# Transverse — read by EVERY binary
# -----------------------------------------------------------------------------
# Read by : every binary, through `init_tracing`
#
# Controls the verbosity of the tracing subscriber.
# Syntax : <target>=<level> — multiple directives separated by commas.
#
# Examples :
#   debug                             → everything at debug and above
#   info                              → recommended for production
#   yog_indexer=debug,warn            → debug for this crate, warn for others
#
# Levels (lowest → highest) : trace | debug | info | warn | error
#
# ⚠️ A value made ONLY of per-target directives silences everything it does not
# name — there is no implicit global level, and a bare TARGET is a directive
# too (`yog_indexer` means `yog_indexer=trace`, not "everything at trace").
#
# One target is exempt, and only because it was worth a guard: `yog_bootstrap`,
# which emits nothing at startup but carries every line of a graceful stop,
# including the `warn!` naming the stage that outlived the grace.
# `build_filter` keeps it audible when the value covers nothing globally. Name
# it explicitly — `yog_bootstrap=off` included — and your directive wins.
RUST_LOG=info,sqlx=warn

# Controls the output format of the tracing subscriber.
#
#   json → structured JSON — recommended for production (Loki, Datadog, etc.)
#   text → human-readable — recommended for local development
#
# If unset, defaults to text.
LOG_FORMAT=text


# -----------------------------------------------------------------------------
# Build tooling — read by cargo, by NO running binary
# -----------------------------------------------------------------------------
# Whether sqlx should run in offline mode (against the cached `.sqlx/`
# directory) instead of querying the live database at compile time.
# Keep `true` for normal builds; set to `false` (or unset) only when
# regenerating the cache via `cargo sqlx prepare`.
SQLX_OFFLINE=true

# Used by `cargo sqlx prepare` to compile-check queries, and to apply
# setup_roles.sql when bootstrapping a database. No binary reads it.
# Used by tooling only — `cargo sqlx prepare --workspace` and to apply
# setup_roles.sql when bootstrapping a new database. Not read by any
# running service.
DATABASE_URL_ADMIN=postgresql://yog:yog@localhost:5433/yog_sothoth
DATABASE_URL=postgresql://yog:yog@localhost:5433/yog_sothoth


# -----------------------------------------------------------------------------
# Convention — how an external endpoint is configured
# -----------------------------------------------------------------------------
# Every address this workspace calls out to is named after WHAT IT SERVES and
# never after the protocol it speaks :
#
#   <FUNCTION>_URL      the address, with `{key}` written where the provider
#                       expects its credential
#   <FUNCTION>_HEADER_NAME    optional, and only with the one below — for a
#   <FUNCTION>_HEADER_VALUE   provider that authenticates by header, not by URL
#   <FUNCTION>_KEY      the credential itself
#
# The parts are joined at the moment of the call. Writing the shape yourself is
# what keeps every provider out of the code — Helius appends `?api-key=`,
# Alchemy `/v2/<key>`, QuickNode `/<token>/`, Triton `?auth=` :
#
#   TOKEN_METADATA_URL=https://mainnet.helius-rpc.com/?api-key={key}
#   TOKEN_METADATA_KEY=your-key
#
#   TOKEN_METADATA_URL=https://solana-mainnet.g.alchemy.com/v2/{key}
#   TOKEN_METADATA_KEY=your-key
#
# `{key}` may sit in a HEADER instead — which is how most providers
# authenticate a gRPC stream, and the header's NAME is a provider convention
# too, so you write that as well :
#
#   <FUNCTION>_HEADER_NAME=x-token
#   <FUNCTION>_HEADER_VALUE={key}
#
#   <FUNCTION>_HEADER_NAME=authorization
#   <FUNCTION>_HEADER_VALUE=Bearer {key}
#
# Two variables and not one `name: value`, for the reason every other variable
# in this file holds exactly one thing : a compound value needs a separator, a
# separator needs a grammar, and a grammar needs validating. The first version
# of this feature took that road and paid 70 lines of parser for it.
#
# ⚠️ ONE endpoint accepts a header : INGEST_STREAM, whose two listeners really
# send it — as gRPC request metadata, or on the WebSocket handshake. On the
# four others it is REFUSED at startup rather than ignored, because their
# consumers send the URL alone (`RpcClient` and the two `reqwest` providers) :
# a header would be dropped in silence and the process would authenticate as
# NOBODY, which any endpoint tolerating anonymous callers answers normally.
# The refusal names the variable and says so.
#
# A public endpoint has no credential to carry : leave `{key}` out, and leave
# `_KEY` unset. A self-hosted node and a free public RPC are both this case.
#
#   TOKEN_METADATA_URL=https://api.mainnet-beta.solana.com
#
# Every refusal below happens at startup and names its variable. There is
# deliberately NO count in this sentence : it was written as "two", then
# "four", then "five", and drifted each time a rule was added — the last time
# in the very commit that fixed the previous drift. A number maintained by hand
# in two files is a number that will be wrong.
#
#   - a `{key}` written anywhere and no `_KEY` set — the process would otherwise
#     send a literal `{key}` and read back a 401 nobody connects to this file;
#   - a `_KEY` set with no `{key}` to receive it — a credential that goes
#     nowhere, which authenticates as anonymous just as silently;
#   - a header set on an endpoint whose consumer sends only the URL, for the
#     reason above : nobody would send it;
#   - half a header pair — a `_HEADER_NAME` without its `_HEADER_VALUE`, or the
#     reverse. The value is never repeated in the error, since it is what
#     carries the credential;
#   - a `_HEADER_NAME` carrying a space or a `:` — it is not a header name, and
#     a `:` is what pasting `x-token: <secret>` whole into it looks like;
#   - a `{key}` written in `_HEADER_NAME`, where it is never substituted and
#     would reach the provider verbatim.
#
# What is legible in a log follows from this file : an address and a header
# print in full exactly to the extent that their credentials are in `_KEY`
# variables. One left inline is one printed.
#
# The five endpoints below may all point at the same host — they do in local
# development — and that repetition is the point : the day one of them moves
# to another provider, this file can say so without touching any code.
#
# ⚠️ One of them is meant NOT to : NETWORK_STATUS is the health probe's, and
# pointing it at the same provider as the ingestion is what makes the two
# halves of the dashboard fail together. The indexer warns at startup when the
# addresses coincide.


# -----------------------------------------------------------------------------
# Convention — the Postgres roles behind the DATABASE_URL_* below
# -----------------------------------------------------------------------------
# Read by : every binary reads exactly one of these; the tooling reads the last two
#
# Four Postgres roles back the application:
#
#   yog_migrate : DDL only — owns the schema, applies migrations.
#                 Used by the one-shot yog-migrate binary, never by a
#                 running service.
#
#   yog_indexer : RW on event tables (pools, swap_events, liquidity_events,
#                 position_fee_claims, reward_claims, pool_current_state,
#                 network_status), RO on watched_pools.
#                 Used by the indexer process at runtime.
#
#   yog_api     : RO on event tables, watched_pools, token_metadata,
#                 token_prices.
#                 Used by the api process at runtime.
#                 User accounts will extend it with RW on user-facing
#                 tables (users, alert_subscriptions, …).
#
#   yog_context : RW on token_metadata and token_prices, RO on pools.
#                 Used by the context process at runtime.
#
#   admin       : full superuser — used by `cargo sqlx prepare` to
#                 compile-check queries across the whole workspace, and
#                 to bootstrap the database (apply setup_roles.sql).
#                 NEVER used by a running service.
#
# The four service roles and their grants are created once per database via
# `crates/persistence/setup_roles.sql`, applied as admin.
#
# Format : postgresql://<user>:<password>@<host>:<port>/<database>
#
# Local development : host = localhost, port = 5433 (the Docker port mapping
#   on the timescaledb container; avoids conflicting with a host PostgreSQL).
#
# Inside the docker compose network : host = postgres, port = 5432 (the
#   container's internal port). docker-compose.yml rewrites these URLs to
#   use the internal hostname when running the dockerised services.
#
# Production (Scaleway Managed PostgreSQL) : provide each connection string
# as an environment variable on the corresponding container — do not ship
# this file to production.


# =============================================================================
# yog-migrate — schema owner, one-shot
# =============================================================================
# Read by : crates/persistence/src/bin/migrate.rs. Never by a running service.

# Read by the yog-migrate binary (crates/persistence/src/bin/migrate.rs).
DATABASE_URL_MIGRATE=postgresql://yog_migrate:CHANGE_ME@localhost:5433/yog_sothoth
#
# `DATABASE_URL_ADMIN` in the header is read by this binary too, for
# `setup-roles` and `seed-watched-pools`.


# =============================================================================
# yog-indexer — ingestion
# =============================================================================
# Read by : the indexer process (crates/indexer/src/bootstrap/config.rs), and by the `inspect_logs` bin for the stream half.

# Read by the indexer process (crates/indexer/src/main.rs).
DATABASE_URL_INDEXER=postgresql://yog_indexer:CHANGE_ME@localhost:5433/yog_sothoth

# Read by : the indexer process (crates/indexer/src/main.rs)
#
# Maximum number of consecutive retries a SubscriptionWorker performs
# before giving up. The counter resets after a successful subscription,
# so this bounds connection failures, not long-running churn.
#
# Required (no implicit default — the value must be explicit in your env).
RPC_WORKER_MAX_RETRIES=10

# What the listener subscribes to :
#   protocols → one subscription per watched protocol, keyed on program id.
#               The target mode, and what the gRPC path is for.
#               ⚠️ On INGEST_SOURCE=rpc it starts and it will saturate: the
#               program's whole firehose, one getTransaction each. Measured
#               at ~200 transactions in 30 s against a ~10 req/s tier.
#   pools     → one per row of `watched_pools`. This is where the allowlist
#               is enforced — at the subscription, not by a filter.
#
# Either way, only protocols whose extraction is actually written are
# subscribed to. A `watched_pools` row for a protocol that is still a stub is
# skipped with a warning rather than fetched and discarded.
INGEST_SCOPE=pools


# -----------------------------------------------------------------------------
# yog-indexer — the chain reference the health probe reads
# -----------------------------------------------------------------------------
# Read by : the indexer process (crates/indexer/src/bootstrap/config.rs), by
#           NetworkStatusReporter and by nothing else.
#
# NOT an ingestion endpoint, and that is the whole point of it having its own
# name. The dashboard's "Solana Live" panel answers two questions that fail
# separately :
#
#   slot / rpcLatencyMs  ← this endpoint : is the CHAIN advancing, and how far
#                          away is it ?
#   freshness            ← the last event written to the database, no network
#                          call at all : is OUR INGESTION keeping up ?
#
# Point this at the ingestion's own endpoint and the two halves go red together
# the day that link drops — precisely when the only thing worth knowing is
# which of the two failed. That is what INGEST_TRANSACTION_URL did until
# 21 September 2026, and under INGEST_SOURCE=grpc it probed a host nothing
# ingested through.
#
# Required on BOTH sources : the probe runs whichever model does. One getSlot
# every 15 s — 0,067 req/s — so the public endpoint carries it comfortably, and
# a provider outage that takes the ingestion down leaves this half answering.
# Pointing it at a second provider is a value in this file, not a code change.
#
# ⚠️ New on 21 September 2026 : an existing .env does NOT have it, and neither
# compose nor the binary carries a default — the indexer stops at start-up
# naming the variable. Add it before `docker compose --profile backend up`.
# The public default below is deliberate : with everything on one provider the
# independence this endpoint exists for would be nominal.
#   NETWORK_STATUS_URL=https://mainnet.helius-rpc.com/?api-key={key}
#   NETWORK_STATUS_KEY=your-key
NETWORK_STATUS_URL=https://api.mainnet-beta.solana.com


# -----------------------------------------------------------------------------
# yog-indexer — HOW TRANSACTIONS ARRIVE : swap block A or block B
# -----------------------------------------------------------------------------
# ⚠️ THE ONE PLACE IN THIS FILE WHERE TWO VARIABLES MUST MOVE TOGETHER, and the
# reason it is laid out as two blocks rather than as loose variables :
# INGEST_STREAM_URL is the only variable whose SCHEME depends on another one.
#
#   INGEST_SOURCE=rpc   -> INGEST_STREAM_URL is wss://   (logsSubscribe)
#                          INGEST_TRANSACTION_URL is required
#   INGEST_SOURCE=grpc  -> INGEST_STREAM_URL is https:// (Yellowstone)
#                          INGEST_TRANSACTION_URL is never read
#
# Flipping INGEST_SOURCE alone is refused at startup, by name : `logsSubscribe`
# simply does not exist on an HTTP endpoint — measured 21 September 2026 on
# api.mainnet-beta.solana.com, which answers `Method not found` — and a
# Yellowstone stream is not a WebSocket. So : comment ONE block whole,
# uncomment the OTHER whole. Nothing outside these two blocks changes.
# Read by : the indexer process (crates/indexer/src/bootstrap/config.rs), and
# by the `inspect_logs` bin for the stream half.
#
# They join the INGEST_* family above, and the two blocks below are two
# variables rather than one because they are two functions : the day the stream
# comes from a Yellowstone gRPC provider and the transactions still come from a
# JSON-RPC node, this file already says it.

# The credential does not attach in the same place at every provider, and on a
# gRPC stream it is usually not in the URL at all. Four shapes were measured on
# 8 September 2026, and all four are written with the same two mechanisms — a
# {key} placeholder, and where to put it. The code knows no provider.
#
#   1. a metadata header, which is what most gRPC providers want :
#        INGEST_STREAM_URL=https://your-endpoint.example:443
#        INGEST_STREAM_HEADER_NAME=x-token
#        INGEST_STREAM_HEADER_VALUE={key}
#        INGEST_STREAM_KEY=your-token
#      the header NAME is a provider convention too — `authorization` with
#      INGEST_STREAM_HEADER_VALUE=Bearer {key} is as legitimate ;
#   2. in the URL, including basic auth where the password is the token :
#        INGEST_STREAM_URL=https://user:{key}@your-endpoint.example ;
#   3. no credential at all — a self-hosted Yellowstone, or an IP allowlist :
#        set neither INGEST_STREAM_KEY nor the header pair ;
#   4. anything else the same two mechanisms can express.
#
# ⚠️ The pair is read the same way whatever INGEST_SOURCE says, and that is the
# point: what decides whether there is a header is these two variables, not the
# acquisition model. Both listeners send it — the gRPC one as request metadata,
# the WebSocket one on the handshake — so a credential written here is a
# credential that leaves.
#
# One consumer does not, and says so: `cargo run --bin inspect_logs`, a
# debugging helper that cannot reach the shared code from its own crate root.
# It refuses to start when the pair is set, rather than connecting without it.


# +-------------------------------------------------------------------------+
# | BLOCK A — INGEST_SOURCE=rpc : notify, then ask.                         |
# | logsSubscribe carries a signature, getTransaction brings the            |
# | transaction back. TWO endpoints. Caps throughput, no transaction_index. |
# +-------------------------------------------------------------------------+
INGEST_SOURCE=rpc

# What the ingestion listens to. Which protocol it speaks is INGEST_SOURCE's
# business, not this variable's : logsSubscribe over WebSocket for `rpc`, a
# Yellowstone gRPC stream for `grpc`.
#
# Free public endpoint (development only — rate-limited, no SLA) :
#   wss://api.mainnet-beta.solana.com
# Provider example (WebSocket) :
#   INGEST_STREAM_URL=wss://mainnet.helius-rpc.com/?api-key={key}
#   INGEST_STREAM_KEY=your-key
INGEST_STREAM_URL=wss://api.mainnet-beta.solana.com
# INGEST_STREAM_KEY=your-key

# Where a transaction is fetched back from, once a notification names its
# signature : getTransaction over HTTP.
#
# ⚠️ Read on INGEST_SOURCE=rpc ONLY, and required there. A Yellowstone stream
# delivers the transaction whole, so there is no second call to configure, and
# nothing on that path reads this pair — leave it unset under `grpc` rather
# than pointing it somewhere harmless. It was required on both paths until
# 21 September 2026, for one reason that has gone away : the health probe read
# it, and now reads NETWORK_STATUS_URL above.
#
# Provider example :
#   INGEST_TRANSACTION_URL=https://mainnet.helius-rpc.com/?api-key={key}
#   INGEST_TRANSACTION_KEY=your-key
INGEST_TRANSACTION_URL=https://api.mainnet-beta.solana.com
# INGEST_TRANSACTION_KEY=your-key


# +-------------------------------------------------------------------------+
# | BLOCK B — INGEST_SOURCE=grpc : delivered whole.                         |
# | One Yellowstone stream carrying whole transactions, each with its index |
# | in its block — the field getTransaction does not return, and the reason |
# | for the change. ONE endpoint: no fetch, so INGEST_TRANSACTION_* is not  |
# | read and is deliberately absent from this block.                        |
# +-------------------------------------------------------------------------+
# INGEST_SOURCE=grpc
#
# # The stream, over gRPC. Same variable as block A, other scheme.
# INGEST_STREAM_URL=https://your-endpoint.example:443
# # Most gRPC providers take the credential in metadata, not in the URL :
# INGEST_STREAM_HEADER_NAME=x-token
# INGEST_STREAM_HEADER_VALUE={key}
# INGEST_STREAM_KEY=your-token


# =============================================================================
# yog-context — tokens, prices, pool accounts
# =============================================================================
# Read by : the context process (crates/context/src/bootstrap/config.rs).

# Read by the context process (crates/context/src/main.rs).
DATABASE_URL_CONTEXT=postgresql://yog_context:CHANGE_ME@localhost:5433/yog_sothoth


# -----------------------------------------------------------------------------
# yog-context — the two Solana endpoints
# -----------------------------------------------------------------------------
# Read by : the context process (crates/context/src/bootstrap/config.rs).
#
# Two variables for what used to be one, and this is the pair the rename exists
# for : the DAS is Helius' own API, `getMultipleAccounts` is standard Solana
# JSON-RPC that any provider serves. Sharing one variable meant a migration
# that moved one and not the other could not be expressed at all.

# Token metadata — Helius DAS (getAssetBatch). A provider-specific API, and
# the one endpoint here whose public default DOES NOT SERVE IT — quietly.
# Measured 6 September 2026: api.mainnet-beta.solana.com answers getAssetBatch
# with `{"result":[null]}`, not with an error, so the daemon runs, every tick
# succeeds, and token names and symbols simply stay empty until you point this
# at a DAS provider. The public default is shipped anyway because the
# alternative — a URL carrying `{key}` with no key beside it — refuses to
# start a fresh clone at all.
#   TOKEN_METADATA_URL=https://mainnet.helius-rpc.com/?api-key={key}
#   TOKEN_METADATA_KEY=your-key
TOKEN_METADATA_URL=https://api.mainnet-beta.solana.com

# Pool accounts — getMultipleAccounts, standard Solana JSON-RPC. Fills the
# nullable pool properties (mints, base fee) the event stream cannot carry.
POOL_ACCOUNT_URL=https://api.mainnet-beta.solana.com


# -----------------------------------------------------------------------------
# yog-context — Jupiter Price API V3
# -----------------------------------------------------------------------------
# Read by : the context process. NOT a `{key}` pair : Jupiter authenticates by header,
#           so its key never enters its URL
#
# Endpoint and authentication for the price worker. Base URL is the Price
# API V3 (https://api.jup.ag); the key is sent on every request
# via the `x-api-key` header. Get a key at https://portal.jup.ag/.
JUPITER_URL=https://api.jup.ag
JUPITER_API_KEY=CHANGE_ME


# -----------------------------------------------------------------------------
# yog-context — daemon intervals
# -----------------------------------------------------------------------------
# Read by : the context process (crates/context/src/main.rs)
#
# How often the metadata worker polls `pools` for mints not yet enriched
# (and fetches them from Helius DAS).
CONTEXT_METADATA_POLL_SECS=10

# How often the price worker fetches USD prices for every known mint
# from Jupiter.
CONTEXT_PRICE_INTERVAL_SECS=30


# =============================================================================
# yog-signals — detectors (everything below is OPTIONAL)
# =============================================================================
# Read by : the signals process (crates/signals/src/bootstrap/config.rs). Every value here has a default, and the defaults are the values shown.

# Read by the yog-signals process (crates/signals/src/main.rs).
DATABASE_URL_SIGNALS=postgresql://yog_signals:CHANGE_ME@localhost:5433/yog_sothoth
#
# ⚠️ For the thresholds below, BLANK IS NOT ABSENT : `FOO=` is a value error,
# not a return to the default. To go back to a default, comment the line out.


# -----------------------------------------------------------------------------
# yog-signals — flow-imbalance detector
# -----------------------------------------------------------------------------
# Read by : the signals process (crates/signals/src/main.rs)
#
# How often the detector ticks.
SIGNALS_FLOW_INTERVAL_SECS=300
# Trailing window over which directional swap volume is aggregated.
SIGNALS_FLOW_WINDOW_HOURS=24
# Rolling per-pool suppression window: a persisting imbalance re-alerts at most
# once per cooldown (a severity escalation overrides it).
SIGNALS_FLOW_COOLDOWN_HOURS=6
# Minimum total window volume (USD) for a pool to be considered — filters out
# thin pools whose ratio would be meaningless.
SIGNALS_FLOW_MIN_VOLUME_USD=10000
# |imbalance| = |(a_to_b - b_to_a)/(a_to_b + b_to_a)| at/above which a signal
# fires (Warning). Must be strictly below SIGNALS_FLOW_CRITICAL.
SIGNALS_FLOW_THRESHOLD=0.6
# |imbalance| at/above which the signal escalates to Critical.
SIGNALS_FLOW_CRITICAL=0.9


# -----------------------------------------------------------------------------
# yog-signals — price-oracle-deviation detector
# -----------------------------------------------------------------------------
# Read by : the signals process
#
# How often the detector ticks.
SIGNALS_PRICE_DEVIATION_INTERVAL_SECS=300
# Rolling per-pool suppression window: a persisting deviation re-alerts at most
# once per cooldown (a severity escalation overrides it).
SIGNALS_PRICE_DEVIATION_COOLDOWN_HOURS=6
# Oldest acceptable oracle price observation — older and the pool is skipped
# (a stale oracle reads as a spurious deviation).
SIGNALS_PRICE_DEVIATION_MAX_PRICE_AGE_MINS=15
# Oldest acceptable last swap — quieter pools are skipped (their spot price is
# history, not a live quote).
SIGNALS_PRICE_DEVIATION_MAX_SPOT_AGE_HOURS=24
# |deviation| = |(spot - oracle)/oracle| at/above which a signal fires
# (Warning). Must be strictly below SIGNALS_PRICE_DEVIATION_CRITICAL.
SIGNALS_PRICE_DEVIATION_THRESHOLD=0.05
# |deviation| at/above which the signal escalates to Critical.
SIGNALS_PRICE_DEVIATION_CRITICAL=0.2


# -----------------------------------------------------------------------------
# yog-signals — TVL-drain detector
# -----------------------------------------------------------------------------
# Read by : the signals process
#
# How often the detector ticks.
SIGNALS_TVL_DRAIN_INTERVAL_SECS=300
# Trailing window over which liquidity flow is aggregated. Short on purpose:
# a drain is fast, a 24h window would dilute it.
SIGNALS_TVL_DRAIN_WINDOW_HOURS=6
# Rolling per-pool suppression window: a persisting drain re-alerts at most
# once per cooldown (a severity escalation overrides it).
SIGNALS_TVL_DRAIN_COOLDOWN_HOURS=6
# Minimum starting TVL (current TVL + net removed, USD) for a pool to be
# considered — a dust pool losing its two dollars is not a drain.
SIGNALS_TVL_DRAIN_MIN_TVL_USD=10000
# drain = net_removed / starting TVL at/above which a signal fires (Warning).
# Must be strictly below SIGNALS_TVL_DRAIN_CRITICAL.
SIGNALS_TVL_DRAIN_THRESHOLD=0.5
# drain at/above which the signal escalates to Critical.
SIGNALS_TVL_DRAIN_CRITICAL=0.8


# =============================================================================
# yog-api — HTTP surface
# =============================================================================
# Read by : the api process (crates/api/src/bootstrap/config.rs).

# Read by the api process (crates/api/src/main.rs).
DATABASE_URL_API=postgresql://yog_api:CHANGE_ME@localhost:5433/yog_sothoth


# -----------------------------------------------------------------------------
# yog-api — bind address and CORS
# -----------------------------------------------------------------------------
# Read by : the api process (crates/api/src/main.rs)
#
# Where the api process listens for incoming TCP connections.
# Format : <host>:<port>  (passed as-is to `TcpListener::bind`).
#
# This is NOT a public URL. There is no `http://` or `https://` here — the
# scheme and TLS termination are handled by the reverse proxy (Caddy on
# Scaleway), not by the api process itself.
#
# Local development (cargo run) : 127.0.0.1:5000
#   Listens on the loopback interface only. Reachable from Next.js running
#   on the same machine, but not from other devices on the LAN.
#
# Docker : 0.0.0.0:5000
#   Required when running inside a container so the reverse proxy on the
#   host can route traffic to it. docker-compose.yml overrides this
#   variable to 0.0.0.0:5000 for the yog-api service automatically.
#
# Next.js (the dashboard) reaches the api via this address in dev. In
# production it goes through https://api.yog-scope.xyz → Caddy → this port.
# Next.js's own configuration (NEXT_PUBLIC_YOG_API_URL) lives in web/.env,
# not here — see the web section at the bottom of this file.
API_BIND_ADDR=127.0.0.1:5000

# Browser origins allowed to call the API (CORS), comma-separated. The
# dashboard fetches the API directly from the browser, so its origin
# must be listed. SSR / server-to-server calls (YOG_API_INTERNAL_URL) and
# tools like curl don't send an Origin header and bypass CORS. In prod
# this becomes the public dashboard origin (e.g. https://yog-scope.xyz).
API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# How often the API's signal-stream poller checks for new signals to push
# to connected /api/signals/stream (SSE) clients. The DB query is skipped
# entirely while no client is connected.
API_SIGNAL_STREAM_POLL_SECS=3


# =============================================================================
# yog-archive — the backup daemon
# =============================================================================
# Read by : the archive process (crates/archive/src/bootstrap/config.rs).
# The full description, and the deployment rules for the bucket and the
# heartbeat, are in crates/archive/README.md. In production the service is
# defined by docker-compose.prod.yml, which refuses to run while any of the
# seven variables below without a default is unset.

# The yog_archive role reads everything and writes nothing.
DATABASE_URL_ARCHIVE=postgresql://yog_archive:CHANGE_ME@localhost:5433/yog_sothoth

# The bucket. A local MinIO for development, Scaleway Object Storage in
# production. The key must be WRITE-ONLY, and the bucket VERSIONED: a
# write-only key cannot delete a dump but can overwrite one, and versioning is
# what keeps the overwritten one. Retention belongs to the bucket's lifecycle
# rule, not to the daemon — see crates/archive/README.md, "Deploying".
ARCHIVE_STORE_URL=http://localhost:9100
ARCHIVE_STORE_BUCKET=yog-backups
ARCHIVE_STORE_REGION=fr-par
ARCHIVE_STORE_ACCESS_KEY=CHANGE_ME
ARCHIVE_STORE_SECRET_KEY=CHANGE_ME

# The dead man's switch: a Healthchecks.io check's ping URL. Required — there
# is no silent mode. The UUID in it is the secret.
ARCHIVE_HEARTBEAT_URL=https://hc-ping.com/CHANGE_ME

# Optional. Six hours by default; the first dump runs at startup.
# ARCHIVE_INTERVAL_SECS=21600

# Optional. The client programs, which must be the server's Postgres major:
# on a host whose default client is older, point at the right one, e.g.
# /usr/lib/postgresql/16/bin/pg_dump.
# ARCHIVE_PG_DUMP=pg_dump
# ARCHIVE_PG_RESTORE=pg_restore


# =============================================================================
# docker compose — the Postgres container itself (not a crate)
# =============================================================================
# Read by : docker-compose.yml only.

# Read by : docker compose only — no binary reads these.
#
# Only consumed by docker-compose.yml to provision the `postgres` service
# (the timescaledb image's POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB).
# These are the credentials of the ADMIN user inside the container, NOT of
# any application role.
#
# Application binaries do not read these variables — they read the five
# DATABASE_URL_* in the crate sections above.
POSTGRES_USER=yog
# Left commented so that a server .env copied from this file does NOT pass
# docker-compose.prod.yml's check with the dev password: the base file
# already defaults it to `yog`, so local development needs nothing here.
# POSTGRES_PASSWORD=yog
POSTGRES_DB=yog_sothoth

# Production only — read by docker-compose.prod.yml, which refuses every
# command while one is unset (and gives POSTGRES_PASSWORD above no default — set it).
# The first two let the server's `docker compose up -d --build` apply the overlay.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# COMPOSE_PROFILES=full
# YOG_WEB_DOMAIN=yog-scope.xyz
# YOG_API_DOMAIN=api.yog-scope.xyz


# =============================================================================
# web — the Next.js dashboard (NOT configured from this file)
# =============================================================================
# The dashboard has its own web/.env; nothing here feeds it.

# Four variables, documented in web/.env.example :
#
#   YOG_API_INTERNAL_URL            server side (Server Components) - required
#   NEXT_PUBLIC_YOG_API_URL         browser side, CORS-locked       - required
#   YOG_API_TIMEOUT_MS              optional, default 5000
#   NEXT_PUBLIC_YOG_API_TIMEOUT_MS  optional, default 5000
#
# plus the NEXT_PUBLIC_FEATURE_* flags. There is no BFF : Server Components and
# the browser both call the API directly, which is why there are two URLs and
# why only one of them is public.
