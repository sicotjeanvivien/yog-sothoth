{
  "components": {
    "schemas": {
      "AnnouncementKindResponse": {
        "description": "What an announcement is about.",
        "enum": [
          "maintenance",
          "incident",
          "release",
          "beta"
        ],
        "type": "string"
      },
      "AnnouncementResponse": {
        "description": "One active operator announcement, as displayed by the web banner.",
        "properties": {
          "endsAt": {
            "description": "End of the display window; `null` = open-ended.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/Count",
            "description": "Storage identity — the client's dismiss-cookie key."
          },
          "kind": {
            "$ref": "#/components/schemas/AnnouncementKindResponse",
            "description": "What it is about: \"maintenance\" | \"incident\" | \"release\" | \"beta\"."
          },
          "linkUrl": {
            "description": "Optional target, e.g. `/changelog#v0.1.0`. `null` when absent.",
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "description": "Free operator text (English, v1 decision).",
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/AnnouncementSeverityResponse",
            "description": "Display prominence: \"info\" | \"warning\" | \"critical\"."
          },
          "startsAt": {
            "description": "Start of the display window.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "severity",
          "message",
          "startsAt",
          "endsAt",
          "linkUrl"
        ],
        "type": "object"
      },
      "AnnouncementSeverityResponse": {
        "description": "How prominently an announcement is shown.",
        "enum": [
          "info",
          "warning",
          "critical"
        ],
        "type": "string"
      },
      "Count": {
        "minimum": 0,
        "type": "integer"
      },
      "EmbeddedTokenResponse": {
        "description": "A token, embedded in another resource's response.",
        "properties": {
          "decimals": {
            "description": "Decimal precision.",
            "format": "u-int8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "logoUri": {
            "description": "Logo URL as returned by DAS. `null` unless it is `http` or `https`.",
            "format": "uri",
            "type": [
              "string",
              "null"
            ]
          },
          "mint": {
            "description": "SPL mint address, base58. `null` until the pool's mints are\nresolved by yog-context.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "Display name (e.g. \"USD Coin\"). `null` for the same reason\nas `symbol`.",
            "type": [
              "string",
              "null"
            ]
          },
          "symbol": {
            "description": "Symbol (e.g. \"USDC\"). `null` when DAS returned no metadata.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "decimals",
          "logoUri",
          "mint",
          "name",
          "symbol"
        ],
        "type": "object"
      },
      "FreshnessStatusResponse": {
        "description": "How recent the last indexed event is.",
        "enum": [
          "live",
          "delayed",
          "stale"
        ],
        "type": "string"
      },
      "IngestionResponse": {
        "description": "Whether our ingestion keeps up, judged on the last event it wrote.",
        "properties": {
          "freshness": {
            "$ref": "#/components/schemas/FreshnessStatusResponse",
            "description": "Ingestion freshness verdict: \"live\" | \"delayed\" | \"stale\"."
          },
          "lastEventAt": {
            "description": "Timestamp of the most recent indexed event, `null` when the database\nholds no events yet.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "freshness",
          "lastEventAt"
        ],
        "type": "object"
      },
      "LatestTvlResponse": {
        "description": "The TVL of every protocol at the close of the last frozen hour.",
        "properties": {
          "asOf": {
            "description": "`null` before the first hour is frozen.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProtocolTvlResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "items",
          "asOf"
        ],
        "type": "object"
      },
      "NetworkResponse": {
        "description": "Where the chain is, as the probe last saw it. The probe's endpoint is not\nthe one ingestion uses: this says nothing about our ingestion.",
        "properties": {
          "observedAt": {
            "description": "When the probe recorded the slot above.",
            "format": "date-time",
            "type": "string"
          },
          "rpcLatencyMs": {
            "description": "Round-trip latency of the probe's last `getSlot` call, in ms — the\ndistance to *that* endpoint, not to the one ingestion uses.",
            "format": "u-int32",
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "slot": {
            "$ref": "#/components/schemas/U128String",
            "description": "Latest Solana slot the probe saw."
          }
        },
        "required": [
          "slot",
          "rpcLatencyMs",
          "observedAt"
        ],
        "type": "object"
      },
      "PageResponse_SignalResponse": {
        "description": "The envelope of every paginated response. `nextCursor`/`prevCursor` are\nopaque, `null` at their boundary; `isFirst`/`isLast` are not redundant with\nthem — a single page has both cursors `null` and both flags `true`.",
        "properties": {
          "isFirst": {
            "type": "boolean"
          },
          "isLast": {
            "type": "boolean"
          },
          "items": {
            "items": {
              "description": "`GET /api/signals` item (and `GET /api/signals/stream` event — both\nendpoints emit exactly this object).",
              "properties": {
                "detector": {
                  "minLength": 1,
                  "type": "string"
                },
                "id": {
                  "$ref": "#/components/schemas/Count",
                  "description": "Storage identity — stable across pages, usable as a client-side\nlist key. Emitted as a JSON number: signals are sparse, the\nsequence will never approach 2^53."
                },
                "message": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "poolAddress": {
                  "minLength": 1,
                  "type": "string"
                },
                "protocol": {
                  "$ref": "#/components/schemas/ProtocolResponse"
                },
                "severity": {
                  "$ref": "#/components/schemas/SeverityResponse"
                },
                "threshold": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/UnsignedDecimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tokenA": {
                  "$ref": "#/components/schemas/EmbeddedTokenResponse",
                  "description": "The pool's token pair: every field nullable until yog-context resolves\nthe pool."
                },
                "tokenB": {
                  "$ref": "#/components/schemas/EmbeddedTokenResponse"
                },
                "triggeredAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "value": {
                  "$ref": "#/components/schemas/SignedDecimal"
                }
              },
              "required": [
                "id",
                "detector",
                "protocol",
                "poolAddress",
                "tokenA",
                "tokenB",
                "severity",
                "value",
                "triggeredAt",
                "message",
                "threshold"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "prevCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "isFirst",
          "isLast",
          "nextCursor",
          "prevCursor"
        ],
        "type": "object"
      },
      "PriceProviderResponse": {
        "description": "Where a price came from.",
        "enum": [
          "jupiter",
          "helius",
          "fallback"
        ],
        "type": "string"
      },
      "ProblemDetailsResponse": {
        "description": "RFC 9457 Problem Details, the body of every error response. `type` is\n`\"about:blank\"` until specific problem types exist, so clients branch on\n`title`; `instance` is omitted, the client knows the path.",
        "properties": {
          "detail": {
            "type": "string"
          },
          "status": {
            "format": "u-int16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "type": "object"
      },
      "ProtocolActivityBarResponse": {
        "description": "One bar, an hour or 24 hours from `from`. A bar with no row had no swap.",
        "properties": {
          "feesUsd": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UnsignedDecimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "from": {
            "format": "date-time",
            "type": "string"
          },
          "poolHours": {
            "$ref": "#/components/schemas/Count"
          },
          "poolHoursValued": {
            "$ref": "#/components/schemas/Count"
          },
          "protocol": {
            "$ref": "#/components/schemas/ProtocolResponse"
          },
          "swapCount": {
            "$ref": "#/components/schemas/Count"
          },
          "volumeUsd": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UnsignedDecimal"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "protocol",
          "from",
          "swapCount",
          "poolHours",
          "poolHoursValued",
          "feesUsd",
          "volumeUsd"
        ],
        "type": "object"
      },
      "ProtocolActivityResponse": {
        "properties": {
          "activePools": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Count",
                "description": "Distinct over the window; `null` when no cycle counted them at its last hour."
              },
              {
                "type": "null"
              }
            ]
          },
          "births": {
            "$ref": "#/components/schemas/Count",
            "description": "Pools initialized during the window."
          },
          "feesUsd": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UnsignedDecimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "lpFeesUsd": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UnsignedDecimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "poolHours": {
            "$ref": "#/components/schemas/Count"
          },
          "poolHoursValued": {
            "$ref": "#/components/schemas/Count"
          },
          "protocol": {
            "$ref": "#/components/schemas/ProtocolResponse"
          },
          "protocolFeesUsd": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UnsignedDecimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "referralFeesUsd": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UnsignedDecimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "swapCount": {
            "$ref": "#/components/schemas/Count"
          },
          "volumeUsd": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UnsignedDecimal"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "protocol",
          "swapCount",
          "births",
          "poolHours",
          "poolHoursValued",
          "activePools",
          "feesUsd",
          "lpFeesUsd",
          "protocolFeesUsd",
          "referralFeesUsd",
          "volumeUsd"
        ],
        "type": "object"
      },
      "ProtocolCatalogResponse": {
        "properties": {
          "observed": {
            "description": "Whether this build ingests the protocol.",
            "type": "boolean"
          },
          "poolsSeen": {
            "$ref": "#/components/schemas/Count"
          },
          "protocol": {
            "$ref": "#/components/schemas/ProtocolResponse"
          }
        },
        "required": [
          "protocol",
          "observed",
          "poolsSeen"
        ],
        "type": "object"
      },
      "ProtocolResponse": {
        "description": "The protocol a pool, an event or a signal belongs to.",
        "enum": [
          "meteora_damm_v2",
          "meteora_dlmm"
        ],
        "type": "string"
      },
      "ProtocolTvlResponse": {
        "description": "A protocol's TVL at `at`, the close of the hour it was last measured in;\n`poolsPriced` is its coverage.",
        "properties": {
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "poolsPriced": {
            "$ref": "#/components/schemas/Count"
          },
          "protocol": {
            "$ref": "#/components/schemas/ProtocolResponse"
          },
          "tvlUsd": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UnsignedDecimal"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "protocol",
          "at",
          "poolsPriced",
          "tvlUsd"
        ],
        "type": "object"
      },
      "SeverityResponse": {
        "description": "How serious a signal is.",
        "enum": [
          "info",
          "warning",
          "critical"
        ],
        "type": "string"
      },
      "SignalResponse": {
        "description": "`GET /api/signals` item (and `GET /api/signals/stream` event — both\nendpoints emit exactly this object).",
        "properties": {
          "detector": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/Count",
            "description": "Storage identity — stable across pages, usable as a client-side\nlist key. Emitted as a JSON number: signals are sparse, the\nsequence will never approach 2^53."
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "poolAddress": {
            "minLength": 1,
            "type": "string"
          },
          "protocol": {
            "$ref": "#/components/schemas/ProtocolResponse"
          },
          "severity": {
            "$ref": "#/components/schemas/SeverityResponse"
          },
          "threshold": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UnsignedDecimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "tokenA": {
            "$ref": "#/components/schemas/EmbeddedTokenResponse",
            "description": "The pool's token pair: every field nullable until yog-context resolves\nthe pool."
          },
          "tokenB": {
            "$ref": "#/components/schemas/EmbeddedTokenResponse"
          },
          "triggeredAt": {
            "format": "date-time",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/SignedDecimal"
          }
        },
        "required": [
          "id",
          "detector",
          "protocol",
          "poolAddress",
          "tokenA",
          "tokenB",
          "severity",
          "value",
          "triggeredAt",
          "message",
          "threshold"
        ],
        "type": "object"
      },
      "SignedDecimal": {
        "pattern": "^-?\\d+(\\.\\d+)?$",
        "type": "string"
      },
      "TokenActivityPageResponse": {
        "description": "The window envelope over a forward-only page: `prevCursor` is always `null`.",
        "properties": {
          "asOf": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "coveredSince": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "from": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "isFirst": {
            "type": "boolean"
          },
          "isLast": {
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/TokenActivityResponse"
            },
            "type": "array"
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "prevCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "window": {
            "$ref": "#/components/schemas/WindowResponse"
          }
        },
        "required": [
          "window",
          "items",
          "isFirst",
          "isLast",
          "asOf",
          "coveredSince",
          "from",
          "nextCursor",
          "prevCursor"
        ],
        "type": "object"
      },
      "TokenActivityResponse": {
        "description": "⚠️ A swap counts for both its tokens: the volumes add up to twice the total.\n`poolHoursValued` of `poolHours` is the volume's coverage.",
        "properties": {
          "poolHours": {
            "$ref": "#/components/schemas/Count"
          },
          "poolHoursValued": {
            "$ref": "#/components/schemas/Count"
          },
          "pools": {
            "$ref": "#/components/schemas/Count",
            "description": "Distinct pools holding the token with a swap in the window."
          },
          "token": {
            "$ref": "#/components/schemas/EmbeddedTokenResponse"
          },
          "volumeUsd": {
            "$ref": "#/components/schemas/UnsignedDecimal"
          }
        },
        "required": [
          "token",
          "volumeUsd",
          "pools",
          "poolHours",
          "poolHoursValued"
        ],
        "type": "object"
      },
      "TokenPriceResponse": {
        "description": "A token's latest price, in `TokenResponse`.",
        "properties": {
          "fetchedAt": {
            "description": "When the price was observed.",
            "format": "date-time",
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/PriceProviderResponse",
            "description": "Origin tag: \"jupiter\" | \"helius\" | \"fallback\"."
          },
          "usd": {
            "$ref": "#/components/schemas/UnsignedDecimal",
            "description": "USD price."
          }
        },
        "required": [
          "usd",
          "provider",
          "fetchedAt"
        ],
        "type": "object"
      },
      "TokenResponse": {
        "description": "The token detail payload.",
        "properties": {
          "decimals": {
            "description": "Decimal precision of the mint.",
            "format": "u-int8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "fetchedAt": {
            "description": "When the metadata was first fetched.",
            "format": "date-time",
            "type": "string"
          },
          "lastRefreshAt": {
            "description": "When the metadata was last refreshed.",
            "format": "date-time",
            "type": "string"
          },
          "logoUri": {
            "description": "Logo URL, as returned by DAS. `null` unless it is `http` or `https`.",
            "format": "uri",
            "type": [
              "string",
              "null"
            ]
          },
          "mint": {
            "description": "SPL mint address, base58.",
            "type": "string"
          },
          "name": {
            "description": "Token name (e.g. \"USD Coin\"). `null` for the same reason as\n`symbol`.",
            "type": [
              "string",
              "null"
            ]
          },
          "price": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TokenPriceResponse",
                "description": "Latest price observation, or `null` if the mint has never\nbeen priced."
              },
              {
                "type": "null"
              }
            ]
          },
          "symbol": {
            "description": "Token symbol (e.g. \"USDC\"). `null` when DAS returned no\nMetaplex metadata.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "mint",
          "decimals",
          "fetchedAt",
          "lastRefreshAt",
          "logoUri",
          "name",
          "price",
          "symbol"
        ],
        "type": "object"
      },
      "U128String": {
        "pattern": "^\\d+$",
        "type": "string"
      },
      "UnsignedDecimal": {
        "pattern": "^\\d+(\\.\\d+)?$",
        "type": "string"
      },
      "WindowResponse": {
        "enum": [
          "24h",
          "7d",
          "30d"
        ],
        "type": "string"
      },
      "WindowedResponse_ProtocolActivityBarResponse": {
        "description": "`from..asOf`, each `null` before the first hour is frozen.",
        "properties": {
          "asOf": {
            "description": "The close of the last frozen hour: the instant the rows reflect.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "coveredSince": {
            "description": "The first hour the facts hold.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "from": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "items": {
              "description": "One bar, an hour or 24 hours from `from`. A bar with no row had no swap.",
              "properties": {
                "feesUsd": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/UnsignedDecimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "from": {
                  "format": "date-time",
                  "type": "string"
                },
                "poolHours": {
                  "$ref": "#/components/schemas/Count"
                },
                "poolHoursValued": {
                  "$ref": "#/components/schemas/Count"
                },
                "protocol": {
                  "$ref": "#/components/schemas/ProtocolResponse"
                },
                "swapCount": {
                  "$ref": "#/components/schemas/Count"
                },
                "volumeUsd": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/UnsignedDecimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "protocol",
                "from",
                "swapCount",
                "poolHours",
                "poolHoursValued",
                "feesUsd",
                "volumeUsd"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "window": {
            "$ref": "#/components/schemas/WindowResponse"
          }
        },
        "required": [
          "window",
          "items",
          "asOf",
          "coveredSince",
          "from"
        ],
        "type": "object"
      },
      "WindowedResponse_ProtocolActivityResponse": {
        "description": "`from..asOf`, each `null` before the first hour is frozen.",
        "properties": {
          "asOf": {
            "description": "The close of the last frozen hour: the instant the rows reflect.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "coveredSince": {
            "description": "The first hour the facts hold.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "from": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "items": {
              "properties": {
                "activePools": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Count",
                      "description": "Distinct over the window; `null` when no cycle counted them at its last hour."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "births": {
                  "$ref": "#/components/schemas/Count",
                  "description": "Pools initialized during the window."
                },
                "feesUsd": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/UnsignedDecimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lpFeesUsd": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/UnsignedDecimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "poolHours": {
                  "$ref": "#/components/schemas/Count"
                },
                "poolHoursValued": {
                  "$ref": "#/components/schemas/Count"
                },
                "protocol": {
                  "$ref": "#/components/schemas/ProtocolResponse"
                },
                "protocolFeesUsd": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/UnsignedDecimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "referralFeesUsd": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/UnsignedDecimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "swapCount": {
                  "$ref": "#/components/schemas/Count"
                },
                "volumeUsd": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/UnsignedDecimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "protocol",
                "swapCount",
                "births",
                "poolHours",
                "poolHoursValued",
                "activePools",
                "feesUsd",
                "lpFeesUsd",
                "protocolFeesUsd",
                "referralFeesUsd",
                "volumeUsd"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "window": {
            "$ref": "#/components/schemas/WindowResponse"
          }
        },
        "required": [
          "window",
          "items",
          "asOf",
          "coveredSince",
          "from"
        ],
        "type": "object"
      },
      "WindowedResponse_ProtocolTvlResponse": {
        "description": "`from..asOf`, each `null` before the first hour is frozen.",
        "properties": {
          "asOf": {
            "description": "The close of the last frozen hour: the instant the rows reflect.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "coveredSince": {
            "description": "The first hour the facts hold.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "from": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "items": {
              "description": "A protocol's TVL at `at`, the close of the hour it was last measured in;\n`poolsPriced` is its coverage.",
              "properties": {
                "at": {
                  "format": "date-time",
                  "type": "string"
                },
                "poolsPriced": {
                  "$ref": "#/components/schemas/Count"
                },
                "protocol": {
                  "$ref": "#/components/schemas/ProtocolResponse"
                },
                "tvlUsd": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/UnsignedDecimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "protocol",
                "at",
                "poolsPriced",
                "tvlUsd"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "window": {
            "$ref": "#/components/schemas/WindowResponse"
          }
        },
        "required": [
          "window",
          "items",
          "asOf",
          "coveredSince",
          "from"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Yog-Scope API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/announcements/active": {
      "get": {
        "operationId": "list_active_announcements",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AnnouncementResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The announcements active now."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            },
            "description": "A failure: RFC 9457 Problem Details."
          }
        },
        "summary": "The announcements whose display window contains the request instant, most\nsevere first then most recent. An empty array is the normal case."
      }
    },
    "/api/ingestion": {
      "get": {
        "operationId": "get_ingestion",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionResponse"
                }
              }
            },
            "description": "How fresh ingestion is."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            },
            "description": "A failure: RFC 9457 Problem Details."
          }
        },
        "summary": "How fresh our ingestion is, judged on the last indexed event. No event at\nall is `stale`, not an error."
      }
    },
    "/api/network": {
      "get": {
        "operationId": "get_network",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NetworkResponse"
                }
              }
            },
            "description": "The chain's latest slot, as the probe saw it."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            },
            "description": "A failure: RFC 9457 Problem Details."
          }
        },
        "summary": "Where the chain is: the latest slot and the probe's latency. The\n`network_status` row is seeded by the baseline migration: its absence is a\n500, not a 404."
      }
    },
    "/api/protocols": {
      "get": {
        "operationId": "list_protocols",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProtocolCatalogResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Every protocol of the domain, observed or not."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            },
            "description": "A failure: RFC 9457 Problem Details."
          }
        }
      }
    },
    "/api/protocols/activity": {
      "get": {
        "operationId": "get_protocol_activity",
        "parameters": [
          {
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "enum": [
                "24h",
                "7d",
                "30d"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "enum": [
                    "24h",
                    "7d",
                    "30d"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WindowedResponse_ProtocolActivityResponse"
                }
              }
            },
            "description": "Each protocol's activity over the window."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            },
            "description": "A failure: RFC 9457 Problem Details."
          }
        }
      }
    },
    "/api/protocols/activity/daily": {
      "get": {
        "operationId": "get_protocol_activity_daily",
        "parameters": [
          {
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "enum": [
                "24h",
                "7d",
                "30d"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WindowedResponse_ProtocolActivityBarResponse"
                }
              }
            },
            "description": "Each protocol's activity, by 24 hours ending at `asOf`."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            },
            "description": "A failure: RFC 9457 Problem Details."
          }
        }
      }
    },
    "/api/protocols/activity/hourly": {
      "get": {
        "operationId": "get_protocol_activity_hourly",
        "parameters": [
          {
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "enum": [
                "24h",
                "7d",
                "30d"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WindowedResponse_ProtocolActivityBarResponse"
                }
              }
            },
            "description": "Each protocol's activity, hour by hour."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            },
            "description": "A failure: RFC 9457 Problem Details."
          }
        }
      }
    },
    "/api/protocols/tvl": {
      "get": {
        "operationId": "get_protocol_tvl",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatestTvlResponse"
                }
              }
            },
            "description": "Each protocol's TVL at the close of the last frozen hour."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            },
            "description": "A failure: RFC 9457 Problem Details."
          }
        }
      }
    },
    "/api/protocols/tvl/hourly": {
      "get": {
        "operationId": "get_protocol_tvl_hourly",
        "parameters": [
          {
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "enum": [
                "24h",
                "7d",
                "30d"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WindowedResponse_ProtocolTvlResponse"
                }
              }
            },
            "description": "Each protocol's TVL at the close of every hour, from the window's start."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            },
            "description": "A failure: RFC 9457 Problem Details."
          }
        }
      }
    },
    "/api/signals": {
      "get": {
        "operationId": "list_signals",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "in": "query",
            "name": "dir",
            "required": false,
            "schema": {
              "enum": [
                "next",
                "prev"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "position",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "enum": [
                    "first",
                    "last"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "in": "query",
            "name": "severity",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "enum": [
                    "info",
                    "warning",
                    "critical"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "in": "query",
            "name": "pool",
            "required": false,
            "schema": {
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "u-int8",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponse_SignalResponse"
                }
              }
            },
            "description": "A page of signals."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            },
            "description": "A failure: RFC 9457 Problem Details."
          }
        }
      }
    },
    "/api/signals/stream": {
      "get": {
        "description": "⚠️ A subscriber that lags past the broadcast capacity is dropped and its\nEventSource reconnects: a silent gap would hide alerts.\n⚠️ At most `SSE_MAX_STREAMS` streams at once, then `503` with `Retry-After`:\neach stream holds memory for as long as it lives.",
        "operationId": "stream_signals",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Server-sent events: each `data` is a `SignalResponse`."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            },
            "description": "A failure: RFC 9457 Problem Details."
          }
        },
        "summary": "Live tail of the signal feed as Server-Sent Events: new signals only, each a\n`SignalResponse` with its id as the event id. History comes from\n`GET /api/signals`, re-fetched on (re)connect."
      }
    },
    "/api/tokens/activity": {
      "get": {
        "operationId": "list_token_activity",
        "parameters": [
          {
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "enum": [
                "24h",
                "7d",
                "30d"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "description": "The only order: the tokens most traded first.",
              "enum": [
                "volume"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "u-int8",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenActivityPageResponse"
                }
              }
            },
            "description": "A page of tokens, the most traded first."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            },
            "description": "A failure: RFC 9457 Problem Details."
          }
        }
      }
    },
    "/api/tokens/{mint}": {
      "get": {
        "operationId": "get_token",
        "parameters": [
          {
            "in": "path",
            "name": "mint",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "The token, with its latest price."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            },
            "description": "A failure: RFC 9457 Problem Details."
          }
        }
      }
    }
  }
}
