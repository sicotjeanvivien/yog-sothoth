  "query": "\n            SELECT protocol, bucket + INTERVAL '1 hour' AS \"at!\", tvl_usd, pools_priced,\n                   pools_unvalued\n              FROM analytic_protocol_tvl\n             WHERE bucket BETWEEN $1 AND $2 AND ($3::TEXT IS NULL OR protocol = $3)\n             ORDER BY bucket, protocol\n            ",
