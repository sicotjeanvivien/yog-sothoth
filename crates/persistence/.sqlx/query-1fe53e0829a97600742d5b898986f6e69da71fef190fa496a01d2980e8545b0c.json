  "query": "\n            SELECT\n                pool_address,\n                protocol,\n                last_event_at,\n                last_event_kind,\n                last_signature,\n                reserve_a,\n                reserve_b,\n                last_sqrt_price,\n                last_swap_at,\n                updated_at\n            FROM pool_current_state\n            WHERE ($1::TIMESTAMPTZ IS NULL OR last_event_at < $1)\n            ORDER BY last_event_at DESC, pool_address ASC\n            LIMIT $2\n            ",
