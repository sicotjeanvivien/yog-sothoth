  "query": "\n            SELECT DISTINCT ON (protocol)\n                   protocol, bucket + INTERVAL '1 hour' AS \"at!\", tvl_usd, pools_priced,\n                   pools_unvalued\n              FROM analytic_protocol_tvl\n             WHERE bucket <= $1 AND ($2::TEXT IS NULL OR protocol = $2)\n             ORDER BY protocol, bucket DESC\n            ",
