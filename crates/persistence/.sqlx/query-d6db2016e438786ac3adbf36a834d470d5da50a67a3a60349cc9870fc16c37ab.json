{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, detector, protocol, pool_address,\n                   severity, value, threshold, message,\n                   triggered_at\n            FROM signals\n            WHERE id > $1\n              AND triggered_at >= now() - $2::BIGINT * INTERVAL '1 second'\n            ORDER BY id ASC\n            LIMIT $3\n            ",
