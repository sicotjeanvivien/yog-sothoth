  "query": "\n            SELECT protocol AS \"protocol!\", bucket AS \"bucket_from!\",\n                   SUM(volume_usd) AS \"volume_usd!\"\n              FROM analytic_rotation_run_hours\n             WHERE protocol = $4\n               AND bucket >= GREATEST($1::TIMESTAMPTZ, $3::TIMESTAMPTZ) AND bucket < $2\n             GROUP BY protocol, bucket\n             ORDER BY bucket\n            ",
