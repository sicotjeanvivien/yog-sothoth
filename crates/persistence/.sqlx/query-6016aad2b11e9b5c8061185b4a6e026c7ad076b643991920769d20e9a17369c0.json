  "db_name": "PostgreSQL",
  "query": "\n            SELECT k.key_hash, c.id AS client_id, c.name AS client_name\n              FROM api_keys k\n              JOIN api_clients c ON c.id = k.client_id\n             WHERE k.revoked_at IS NULL\n               AND c.revoked_at IS NULL\n            ",
