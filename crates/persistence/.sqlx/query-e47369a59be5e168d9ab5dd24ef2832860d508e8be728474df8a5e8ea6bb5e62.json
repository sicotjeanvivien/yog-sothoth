  "query": "\n            SELECT mint,\n                  price_usd AS \"price_usd!: rust_decimal::Decimal\",\n                  price_provider, confidence, fetched_at\n            FROM token_prices\n            WHERE mint = $1 AND fetched_at >= $2\n              AND fetched_at < COALESCE($3, 'infinity'::TIMESTAMPTZ)\n            ORDER BY fetched_at DESC\n            LIMIT $4\n            ",
