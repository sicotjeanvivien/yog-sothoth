  "query": "\n            SELECT id, pool_address, signature, timestamp, slot, transaction_index, event_index,\n                   owner, position, position_nft_mint\n              FROM meteora_damm_v2_close_position_events\n             WHERE id > $1\n               AND timestamp >= now() - $2::BIGINT * INTERVAL '1 second'\n             ORDER BY id\n             LIMIT $3\n            ",
