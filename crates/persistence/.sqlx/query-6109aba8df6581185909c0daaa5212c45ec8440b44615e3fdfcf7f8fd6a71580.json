  "query": "\n            SELECT k.prefix, c.name AS client, k.created_at, k.revoked_at\n              FROM api_keys k\n              JOIN api_clients c ON c.id = k.client_id\n             ORDER BY k.created_at DESC, k.id DESC\n            ",
