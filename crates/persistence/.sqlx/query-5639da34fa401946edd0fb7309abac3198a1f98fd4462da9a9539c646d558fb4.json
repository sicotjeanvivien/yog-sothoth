  "query": "\n            SELECT protocol, bucket AS \"bar_from?\", created_usd, added_usd, removed_usd,\n                   moves, moves_valued\n              FROM analytic_protocol_liquidity_hourly\n             WHERE protocol = $4\n               AND bucket >= GREATEST($1::TIMESTAMPTZ, $3::TIMESTAMPTZ) AND bucket < $2\n             ORDER BY bucket\n            ",
