  "query": "\n            SELECT protocol AS \"protocol!\", NULL::TIMESTAMPTZ AS bar_from,\n                   SUM(births)::BIGINT AS \"pools!\"\n              FROM analytic_protocol_births_hourly\n             WHERE bucket >= $1 AND bucket < $2\n               AND ($3::TEXT IS NULL OR protocol = $3)\n             GROUP BY protocol\n             ORDER BY protocol\n            ",
