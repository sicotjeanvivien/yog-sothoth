  "db_name": "PostgreSQL",
  "query": "\n                SELECT id, pool_address, signature, timestamp, slot, transaction_index, event_index,\n                       reward_mint, amount\n                  FROM meteora_damm_v2_withdraw_ineligible_reward_events\n                 WHERE id > $1\n                   AND timestamp >= now() - $2::BIGINT * INTERVAL '1 second'\n                 ORDER BY id\n                 LIMIT $3\n                ",
