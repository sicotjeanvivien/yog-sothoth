# Caddyfile — mounted by docker-compose.prod.yml only.
#
# Two sites, because the browser calls the API directly (there is no BFF):
# the dashboard's pages and the API each have their own host name. Caddy
# obtains and renews their certificates on its own.
#
# The domains come from the environment, set in the server's .env.
#
# No visitor IP in the logs. Caddy keeps no access log without a `log`
# directive, but its default logger still writes every failed request
# (`http.log.error`, e.g. a 502 while yog-web or yog-api restarts) with
# the client's IP, port and headers, User-Agent included — measured on
# 2.11.4. The privacy page says the IP is written to no log, and Docker
# keeps these lines with no rotation. The filter drops those fields and
# keeps what diagnoses the error: method, host, uri, status, cause.
{
	log default {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
			}
		}
	}
}

# HSTS on both sites: the browser keeps to HTTPS for a year once it has seen
# one answer. Without `includeSubDomains`, which set on the apex would bind
# every future subdomain to HTTPS, and without `preload`, a commitment that
# takes months to undo. The other security headers are set by the services
# themselves (next.config.ts, yog-api's middleware).
(hsts) {
	header Strict-Transport-Security "max-age=31536000"
}

{$YOG_WEB_DOMAIN} {
	import hsts
	encode zstd gzip
	reverse_proxy yog-web:3000
}

# No `encode` on this site: /api/signals/stream is Server-Sent Events, and
# a compressor holds small writes until it has enough to compress — the
# events would arrive late and in bursts. Without it, Caddy flushes a
# `text/event-stream` response as it arrives.
#
# The pools list is cached 30 s by the browser: it is the dashboard's main
# read, fetched on every visit, and its rows move with the indexer, not with
# the second. Only a success is marked: a 500 while yog-api restarts must not
# be kept 30 s. Here and not in yog-api, so that dev — which calls the API
# without Caddy — never sees a list frozen for 30 s.
{$YOG_API_DOMAIN} {
	import hsts

	@pools_list {
		method GET
		path /api/pools
	}
	handle @pools_list {
		reverse_proxy yog-api:5000 {
			@success status 2xx
			handle_response @success {
				header Cache-Control "public, max-age=30"
				copy_response
			}
		}
	}

	handle {
		reverse_proxy yog-api:5000
	}
}
